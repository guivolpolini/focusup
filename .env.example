# FocusUp - Configuração de IA Local e FreeLLMAPI
# O FocusUp opera 100% offline por padrão.
# Para ativar a leitura com IA multimodal via FreeLLMAPI local (Docker):

OPENAI_BASE_URL=http://localhost:3001/v1
OPENAI_API_KEY=your_freellmapi_key_here
VITE_OPENAI_BASE_URL=http://localhost:3001/v1
VITE_OPENAI_API_KEY=your_freellmapi_key_here
